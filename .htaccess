<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # biarkan asset, uploads, images dibaca langsung, tidak lewat index.php
    RewriteCond %{REQUEST_URI} ^/(assets|uploads|images)/
    RewriteRule .* - [L]

    # jika file atau folder tidak ada, lempar ke index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>
